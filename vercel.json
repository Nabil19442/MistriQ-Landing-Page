{
  "buildCommand": "cd landing && npm run build",
  "outputDirectory": "landing/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/Mistri_Q.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Mistri_Q.apk\""
        }
      ]
    }
  ]
}

